@   IN  SOA ns1.sciel33.com. admin.sciel33.com. (
        1		    ; serial 
        3600        ; refresh
        1800        ; retry
        604800      ; expire
        86400       ; minimum
)

@   IN  NS ns1.sciel33.com.
ns1 IN  A   10.49.3.1

@   IN  NS  ns2.sciel33.com.
ns2 IN  A   10.49.3.2

@   IN A 10.49.2.2
www IN CNAME sciel33.com.
exp IN CNAME sciel33.com.
